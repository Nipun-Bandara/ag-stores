generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  SHOP_OWNER
  DELIVERY_PERSON
  ADMIN
}

enum PreferredLanguage {
  EN
  SI
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CatalogStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PREPARING
  READY_FOR_DELIVERY
  ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REJECTED
  FAILED_DELIVERY
}

enum PaymentMethod {
  CASH_ON_DELIVERY
}

enum DeliveryBatchStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id                String            @id @default(uuid()) @db.Uuid
  assignedShopId    String?           @db.Uuid
  name              String            @db.VarChar(150)
  email             String?           @unique @db.VarChar(320)
  phone             String?           @unique @db.VarChar(32)
  passwordHash      String            @db.VarChar(255)
  role              UserRole
  preferredLanguage PreferredLanguage @default(EN)
  status            UserStatus        @default(ACTIVE)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)

  ownedShops         Shop[]               @relation("ShopOwner")
  assignedShop       Shop?                @relation("ShopDeliveryPersonnel", fields: [assignedShopId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  addresses          CustomerAddress[]    @relation("CustomerAddresses")
  customerOrders     Order[]              @relation("CustomerOrders")
  deliveryBatches    DeliveryBatch[]      @relation("DeliveryPersonBatches")
  sessions           AuthSession[]
  orderStatusChanges OrderStatusHistory[] @relation("OrderStatusChangedBy")

  @@index([role, status])
  @@index([assignedShopId, status])
  @@map("users")
}

model AuthSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique @db.Char(64)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Shop {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @db.Uuid
  name      String   @db.VarChar(180)
  address   String
  latitude  Decimal  @db.Decimal(9, 6)
  longitude Decimal  @db.Decimal(10, 6)
  phone     String   @db.VarChar(32)
  isOpen    Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  owner             User       @relation("ShopOwner", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  deliveryPersonnel User[]     @relation("ShopDeliveryPersonnel")
  categories        Category[]
  products          Product[]
  orders            Order[]

  @@index([ownerId])
  @@index([isOpen])
  @@map("shops")
}

model CustomerAddress {
  id         String  @id @default(uuid()) @db.Uuid
  customerId String  @db.Uuid
  label      String  @db.VarChar(80)
  address    String
  latitude   Decimal @db.Decimal(9, 6)
  longitude  Decimal @db.Decimal(10, 6)
  isDefault  Boolean @default(false)

  customer User    @relation("CustomerAddresses", fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  orders   Order[] @relation("OrderDeliveryAddress")

  @@unique([id, customerId])
  @@unique([customerId, label])
  @@index([customerId])
  @@index([customerId, isDefault])
  @@map("customer_addresses")
}

model Category {
  id     String        @id @default(uuid()) @db.Uuid
  shopId String        @db.Uuid
  nameEn String        @db.VarChar(120)
  nameSi String?       @db.VarChar(120)
  status CatalogStatus @default(ACTIVE)

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  products Product[]

  @@unique([id, shopId])
  @@unique([shopId, nameEn])
  @@index([shopId, status])
  @@map("categories")
}

model Product {
  id            String   @id @default(uuid()) @db.Uuid
  shopId        String   @db.Uuid
  categoryId    String   @db.Uuid
  nameEn        String   @db.VarChar(180)
  nameSi        String?  @db.VarChar(180)
  descriptionEn String?
  descriptionSi String?
  price         Decimal  @db.Decimal(12, 2)
  stockQuantity Int      @default(0)
  imageUrl      String?  @db.VarChar(2048)
  isAvailable   Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  shop       Shop        @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category   Category    @relation(fields: [categoryId, shopId], references: [id, shopId], onDelete: Restrict, onUpdate: Cascade)
  orderItems OrderItem[]

  @@unique([shopId, nameEn])
  @@index([categoryId, shopId])
  @@index([shopId, isAvailable])
  @@map("products")
}

model Order {
  id                 String        @id @default(uuid()) @db.Uuid
  customerId         String        @db.Uuid
  shopId             String        @db.Uuid
  deliveryAddressId  String        @db.Uuid
  status             OrderStatus   @default(PLACED)
  paymentMethod      PaymentMethod @default(CASH_ON_DELIVERY)
  subtotal           Decimal       @db.Decimal(12, 2)
  deliveryFee        Decimal       @db.Decimal(12, 2)
  total              Decimal       @db.Decimal(12, 2)
  customerNote       String?
  cancelledAt        DateTime?     @db.Timestamptz(3)
  cancellationReason String?       @db.VarChar(500)
  createdAt          DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @db.Timestamptz(3)

  customer        User                 @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  shop            Shop                 @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  deliveryAddress CustomerAddress      @relation("OrderDeliveryAddress", fields: [deliveryAddressId, customerId], references: [id, customerId], onDelete: Restrict, onUpdate: Cascade)
  items           OrderItem[]
  batchAssignment DeliveryBatchOrder?
  statusHistory   OrderStatusHistory[]

  @@index([customerId, createdAt])
  @@index([shopId, status, createdAt])
  @@index([deliveryAddressId, customerId])
  @@index([status, createdAt])
  @@index([cancelledAt])
  @@map("orders")
}

model OrderStatusHistory {
  id          String      @id @default(uuid()) @db.Uuid
  orderId     String      @db.Uuid
  fromStatus  OrderStatus
  toStatus    OrderStatus
  changedById String      @db.Uuid
  note        String?
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)

  order     Order @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  changedBy User  @relation("OrderStatusChangedBy", fields: [changedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([orderId, createdAt])
  @@index([changedById, createdAt])
  @@map("order_status_history")
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @db.Uuid
  productId String  @db.Uuid
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([orderId, productId])
  @@index([productId])
  @@map("order_items")
}

model DeliveryBatch {
  id               String              @id @default(uuid()) @db.Uuid
  deliveryPersonId String              @db.Uuid
  status           DeliveryBatchStatus @default(PENDING)
  startedAt        DateTime?           @db.Timestamptz(3)
  completedAt      DateTime?           @db.Timestamptz(3)

  deliveryPerson User                 @relation("DeliveryPersonBatches", fields: [deliveryPersonId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  orders         DeliveryBatchOrder[]

  @@index([deliveryPersonId, status])
  @@map("delivery_batches")
}

model DeliveryBatchOrder {
  batchId  String @db.Uuid
  orderId  String @unique @db.Uuid
  sequence Int

  batch DeliveryBatch @relation(fields: [batchId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  order Order         @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([batchId, orderId])
  @@unique([batchId, sequence])
  @@map("delivery_batch_orders")
}
