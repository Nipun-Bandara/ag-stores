# PostgreSQL connection string used by Prisma at runtime and for migrations.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ag_stores?schema=public"

# Dedicated database used only by PostgreSQL integration tests.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ag_stores_test?schema=public"

# Public origin of the application.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication abuse protection. Use lower values only with care in shared networks.
AUTH_RATE_LIMIT_MAX_ATTEMPTS="10"
AUTH_RATE_LIMIT_MAX_ATTEMPTS_PER_IP="50"

# Delivery map provider. Keep "disabled" when no provider is configured.
# Mapbox browser tokens are intentionally public and must begin with "pk.".
# Never place an sk.* secret token in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_MAP_PROVIDER="disabled"
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=""

# Supabase Storage project URL. The upload route also accepts an existing
# NEXT_PUBLIC_SUPABASE_URL, so this line is optional when that is already set.
# SUPABASE_URL="https://your-project.supabase.co/"
# Server-only key for product-photo writes. Use the project's sb_secret_ key.
# Never prefix this key with NEXT_PUBLIC_ or expose it to browser code.
SUPABASE_SECRET_KEY=""
# Older projects may instead use a legacy service_role key:
# SUPABASE_SERVICE_ROLE_KEY=""
