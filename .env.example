# PostgreSQL connection string used by Prisma at runtime and for migrations.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ag_stores?schema=public"

# Dedicated database used only by PostgreSQL integration tests.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ag_stores_test?schema=public"

# Public origin of the application.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Delivery map provider. Keep "disabled" when no provider is configured.
# Mapbox browser tokens are intentionally public and must begin with "pk.".
# Never place an sk.* secret token in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_MAP_PROVIDER="disabled"
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=""
